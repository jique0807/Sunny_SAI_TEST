# Never commit real values. Register each map provider's allowed deployment domain.
APP_ORIGIN=http://localhost:5173
SESSION_SECRET=
KAKAO_REST_API_KEY=
KAKAO_JAVASCRIPT_KEY=
VWORLD_API_KEY=
# User Google Cloud TTS keys are entered only in the app's optional advanced voice settings.

# Server-only KMA API Hub credential
KMA_API_KEY=
# Server-only Safety Map WMS credential (national-river flood extent; not live flooding)
SAFEMAP_API_KEY=

# Optional LLM explanation adapter. Keys are server-only; never commit real values.
# gemini: fixed Google endpoint; compatible: administrator-configured /v1 endpoint.
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# Alternative server-side Gemini key (used only for the gemini adapter).
GEMINI_API_KEY=

# Gemma/GPT-OSS independent server-only OpenAI-compatible model presets.
# Do not commit actual values. Keep API keys off the browser.
LLM_GEMMA_MODEL=
LLM_GEMMA_BASE_URL=
LLM_GEMMA_API_KEY=
LLM_GPT_OSS_MODEL=
LLM_GPT_OSS_BASE_URL=
LLM_GPT_OSS_API_KEY=
